APP_NAME=Watchtower
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL 18. Порт 5432, а не 3306: шаблон Laravel приезжает с портом MySQL.
#
# Значения ниже — ЛОКАЛЬНЫЕ и рабочие сразу после копирования: unix-сокет и
# peer-аутентификация, пароля нет вовсе. Прежний вариант (TCP на 127.0.0.1 с
# пустым паролем) не поднимал соединение ни локально, ни на бою — pg_hba
# требует пароль для host-подключений, и первый же artisan падал.
#
# На боевой машине: DB_HOST=/var/run/postgresql остаётся (база слушает только
# localhost по AD-1, а сокет ещё и не занимает порт), DB_PASSWORD задаётся
# из createuser --pwprompt и в репозиторий не попадает.
#
# Перед первым запуском создать две базы — рабочую и тестовую:
#
#   sudo -u postgres createuser --createdb "$USER"      # только на машине разработчика
#   createdb watchtower
#   createdb watchtower_test
#
# При peer-аутентификации имя в DB_USERNAME обязано совпадать с системным
# пользователем, от которого идёт запуск: локально это ваш логин, на бою —
# watchtower, от которого работает пул php-fpm. Несовпадение даёт
# «Peer authentication failed for user», а не отказ в правах.
#
# Имя тестовой базы обязано оканчиваться на _test: TestCase отказывается
# работать с любым другим, потому что RefreshDatabase роняет все таблицы той
# базы, до которой дотянулся. Перекрывается оно в phpunit.xml с force="true".
# Токены исполнителя (AD-13). Значения через запятую — принимается любое из
# них. Список, а не одно значение, ради ротации без окна отказа: новый токен
# добавляется выкатом, исполнитель переводится на него, старый убирается
# следующим выкатом.
#
# Пустой список означает отказ всем: забытая переменная лишает доступа,
# а не открывает его.
#
# Сгенерировать значение:
#
#   php8.5 -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#
# Репозиторий публичный (AD-25) — здесь остаётся пустая строка, реальные
# значения живут только в .env на машине.
WORKER_TOKENS=

DB_CONNECTION=pgsql
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_DATABASE=watchtower
DB_USERNAME=watchtower
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
