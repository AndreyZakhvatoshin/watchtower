[Unit]
Description=Запуск продления сертификатов дважды в сутки

[Timer]
# Дважды в сутки — рекомендация Let's Encrypt. Продление происходит не при
# каждом запуске: acme.sh обновляет сертификат за 30 дней до конца срока
# либо в окне, которое УЦ назначает через ARI (для текущего сертификата —
# 09–11.10.2026).
OnCalendar=*-*-* 04,16:00:00

# Разброс до часа. Без него все машины мира с этой же рекомендацией приходят
# к УЦ ровно в 04:00, и Let's Encrypt отдельно просит так не делать.
RandomizedDelaySec=1h

# Догон пропущенного запуска после простоя машины. Именно этого нет у cron:
# выключенная на сутки машина пропустила бы окно молча.
Persistent=true

[Install]
WantedBy=timers.target
